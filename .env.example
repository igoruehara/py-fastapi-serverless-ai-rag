APP_NAME=FastAPI Serverless Lambda
STAGE=dev
AWS_REGION=us-east-1
APP_CONFIG_SOURCE=env
APP_SSM_PREFIX=
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# Filled automatically by serverless in AWS.
# For local tests, set them manually if needed.
NLP_CONVERSATION_QUEUE_URL=
CONNECTIONS_TABLE=
WS_ENDPOINT=

# LLM providers.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=

# Milvus / Zilliz.
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=rag_documents
MILVUS_EMBEDDING_DIM=3072
